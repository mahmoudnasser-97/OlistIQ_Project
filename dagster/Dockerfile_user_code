# =============================================================================
# dagster/Dockerfile_user_code
# =============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# ── OS packages ──────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        wget \
        openjdk-21-jdk-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Java ─────────────────────────────────────────────────────────────────────
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Spark (installed via PySpark — no tarball download needed) ────────────────
# pyspark ships its own spark-submit under $VIRTUAL_ENV/lib/pythonX.Y/site-packages/pyspark
# We symlink it to /opt/spark so spark-submit is on PATH as expected.
ENV SPARK_HOME=/opt/spark
ENV PATH="${SPARK_HOME}/bin:${PATH}"

# ── Python packages ───────────────────────────────────────────────────────────
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        dagster==1.7.15 \
        dagster-postgres==0.23.15 \
        dagster-docker==0.23.15 \
        pyspark==3.5.0 \
        delta-spark==3.0.0 \
        boto3==1.34.0 \
        psycopg2-binary==2.9.9 \
        pandas==2.0.3 \
        pyarrow==14.0.2

# ── Symlink PySpark's bundled Spark to /opt/spark ────────────────────────────
RUN PYSPARK_HOME=$(python -c "import pyspark; import os; print(os.path.dirname(pyspark.__file__))") \
    && ln -s "$PYSPARK_HOME" /opt/spark

# ── Spark JARs ────────────────────────────────────────────────────────────────
ENV DELTA_VERSION=3.0.0
ENV HADOOP_AWS_VERSION=3.3.4
ENV AWS_SDK_VERSION=1.12.540
ENV PG_JDBC_VERSION=42.6.0
ENV SCALA_VERSION=2.12
ENV MAVEN=https://repo1.maven.org/maven2
ENV JARS=${SPARK_HOME}/jars

RUN wget -q -P ${JARS} \
      "${MAVEN}/io/delta/delta-spark_${SCALA_VERSION}/${DELTA_VERSION}/delta-spark_${SCALA_VERSION}-${DELTA_VERSION}.jar" \
    && wget -q -P ${JARS} \
      "${MAVEN}/io/delta/delta-storage/${DELTA_VERSION}/delta-storage-${DELTA_VERSION}.jar" \
    && wget -q -P ${JARS} \
      "${MAVEN}/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
    && wget -q -P ${JARS} \
      "${MAVEN}/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_VERSION}/aws-java-sdk-bundle-${AWS_SDK_VERSION}.jar" \
    && wget -q -P ${JARS} \
      "https://jdbc.postgresql.org/download/postgresql-${PG_JDBC_VERSION}.jar" \
    && echo "JARs installed:" && ls ${JARS} | grep -E "delta|hadoop-aws|aws-java|postgresql"

# ── spark-defaults.conf ───────────────────────────────────────────────────────
RUN mkdir -p ${SPARK_HOME}/conf \
    && { printf '%s\n' \
      'spark.master                                    spark://spark-master:7077' \
      'spark.sql.extensions                            io.delta.sql.DeltaSparkSessionExtension' \
      'spark.sql.catalog.spark_catalog                 org.apache.spark.sql.delta.catalog.DeltaCatalog' \
      'spark.hadoop.fs.s3a.endpoint                    http://minio:9000' \
      'spark.hadoop.fs.s3a.access.key                  minioadmin' \
      'spark.hadoop.fs.s3a.secret.key                  minioadmin' \
      'spark.hadoop.fs.s3a.path.style.access           true' \
      'spark.hadoop.fs.s3a.impl                        org.apache.hadoop.fs.s3a.S3AFileSystem' \
      'spark.hadoop.fs.s3a.aws.credentials.provider    org.apache.hadoop.fs.s3a.SimpleAWSCredentialsProvider' \
      'spark.sql.shuffle.partitions                    8' \
      'spark.databricks.delta.schema.autoMerge.enabled true' ; } \
      > ${SPARK_HOME}/conf/spark-defaults.conf

# ── Copy pipeline code ────────────────────────────────────────────────────────
WORKDIR /opt/dagster/app
COPY pipelines/ /opt/dagster/app/

EXPOSE 4000

HEALTHCHECK \
    --timeout=3s \
    --start-period=10s \
    --interval=5s \
    --retries=20 \
    CMD ["dagster", "api", "grpc-health-check", "-p", "4000"]

CMD ["dagster", "code-server", "start", \
     "-h", "0.0.0.0", \
     "-p", "4000", \
     "-f", "olist_assets.py"]
